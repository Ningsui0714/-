# 岗位任务转化 -> 个性化学习：功能级私密配置
# 复制为 backend/.private/personalized_learning.env；真实地址不要提交到 Git。
PERSONALIZED_LEARNING_IMPORT_URL=http://127.0.0.1:4174/api/integrations/learning-task-knowledge
# 服务器部署时可保留回环导入地址，并通过反向代理返回浏览器可访问入口。
PERSONALIZED_LEARNING_PUBLIC_BASE_URL=https://example.com/personalized-learning/
PERSONALIZED_LEARNING_TIMEOUT_SECONDS=20
# 拆分部署且下游启用 APP_API_TOKEN 时填写；同仓 localhost 模式留空。
PERSONALIZED_LEARNING_API_TOKEN=
