# Copy this file to:
#   backend/.private/learning_task_conversion.xfyun.env
#
# This file is read only by the 岗位典型工作任务转化 integration. Never
# commit real credential values.
XFYUN_APP_ID=your-app-id
XFYUN_API_KEY=your-api-key
XFYUN_API_SECRET=your-api-secret
XFYUN_FLOW_ID=your-api-flow-id
XFYUN_WORKFLOW_BASE_URL=https://xingchen-api.xf-yun.com
XFYUN_WORKFLOW_TIMEOUT_SECONDS=240
