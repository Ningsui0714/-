# LLM Provider
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# LearnFlow
DATABASE_URL=sqlite+aiosqlite:///./learnflow.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# true 时仅用于隔离的离线比赛演示库；正常开发保持 false
COMPETITION_DEMO_MODE=false
# Tauri sidecar injects both values for each launch. Never enable this on a
# remotely reachable server or commit a real token.
DESKTOP_MODE=false
DESKTOP_TOKEN=
# Keep queued consolidations inspectable until offline replay gates pass.
MEMORY_AUTO_SYNTHESIS_ENABLED=false
# Optional: raises the GitHub API rate limit for proposal resource search
# GITHUB_TOKEN=github_pat_...
# GITHUB_RESOURCE_SEARCH_ENABLED=true
# DEV_TEST_LOGIN_ENABLED=true
# AUTH_COOKIE_SECURE=false

# Embedding
# EMBEDDING_BACKEND=local   # local (gte-small, default) | api (OpenAI-compatible)
# EMBEDDING_MODEL=text-embedding-ada-002

# Embedding (optional — separate from LLM config)
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Vision (image understanding) — Moonshot
# VISION_API_KEY=sk-...        # 留空则复用 LLM_API_KEY（若同 provider）
# VISION_BASE_URL=https://api.moonshot.cn/v1
# VISION_MODEL=kimi-k2.7-code-highspeed  # 已实测支持视觉且最快

# Reference-source cache (images/markdown persisted from GitHub/URL sources).
# This is not a project workspace.
# SOURCE_CACHE_DIR=data/repo-files
# Uploaded reference originals (also not a project workspace).
# SOURCE_UPLOADS_DIR=data/source-uploads
