APP_HOST=127.0.0.1
APP_PORT=4173
APP_DATABASE=backend/data/learning_app.db
APP_SEED_DEMO=1
# 逗号分隔的跨域来源白名单；同源请求不受影响。
APP_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# 本机开发可留空；监听非回环地址时必须设置，并由调用方发送 Bearer Token。
APP_API_TOKEN=

# mock：无需密钥即可本地联调；remote：调用讯飞星辰已发布工作流。
# 版本锁定（2026-08-05）：v5 为唯一正式契约，Flow ID 对应：
#   学生画像分析工作流 / 个性化推荐工作流 / 目标与路径规划工作流 / 对话问答 / WF04
# 注意：学习/纠错讲解与检索规划/质量审核已全部本地化（见下方 SPARK_*），不再走星辰工作流。
XINGCHEN_MODE=mock

# workflow_v1 会发送 flow_id、uid、parameters.AGENT_USER_INPUT。
# 如果星辰发布页给出的是独立代理地址和不同请求体，可改为 direct。
XINGCHEN_REQUEST_STYLE=workflow_v1
XINGCHEN_API_URL=https://xingchen-api.xf-yun.com/workflow/v1/chat/completions
# 画像/推荐/目标/对话/出题/WF04 工作流；未配置时继续回退到 XINGCHEN_FLOW_ID。
XINGCHEN_PROFILE_FLOW_ID=
XINGCHEN_GOAL_FLOW_ID=
XINGCHEN_RECOMMEND_FLOW_ID=
XINGCHEN_CHAT_FLOW_ID=
XINGCHEN_QUIZ_FLOW_ID=
XINGCHEN_WF04_FLOW_ID=
# [停用] 讲解模块已本地化，以下两项不再被调用（历史保留，避免配置误用）。
XINGCHEN_LEARNING_FLOW_ID=
XINGCHEN_REMEDIATION_FLOW_ID=
XINGCHEN_KNOWLEDGE_PLANNING_FLOW_ID=
XINGCHEN_KNOWLEDGE_AUDIT_FLOW_ID=

# 个性化学习内容引擎（OpenAI 兼容 Chat Completions）。
# 密钥为空时使用本地课程知识库确定性模板。
CONTENT_LLM_API_BASE=https://api.deepseek.com/chat/completions
CONTENT_LLM_API_KEY=
CONTENT_LLM_MODEL=deepseek-v4-flash
CONTENT_LLM_TIMEOUT=60
CONTENT_LLM_MAX_TOKENS=1600
CONTENT_LLM_TEMPERATURE=0.4
# 兼容旧配置：未设置 CONTENT_LLM_* 时仍会读取 DEEPSEEK_* 或 SPARK_*。
# WF04 可使用另一已发布应用的独立地址与凭据；留空时兼容回退到通用配置。
XINGCHEN_WF04_API_URL=
XINGCHEN_WF04_API_KEY=
XINGCHEN_WF04_API_SECRET=
XINGCHEN_FLOW_ID=
XINGCHEN_INPUT_KEY=AGENT_USER_INPUT
XINGCHEN_API_KEY=
XINGCHEN_API_SECRET=
XINGCHEN_AUTH_HEADER=Authorization
XINGCHEN_AUTH_SCHEME=Bearer
XINGCHEN_TIMEOUT=210

# bing_rss：后端联网搜索带来源的视频；off：关闭联网视频搜索
VIDEO_SEARCH_MODE=bilibili
VIDEO_SEARCH_URL=https://www.bing.com/search?format=rss&q={query}
VIDEO_SEARCH_TIMEOUT=12
VIDEO_SEARCH_MAX_RESULTS=4
VIDEO_SEARCH_CACHE_SECONDS=3600
# 联网文档检索（前端文档板块）：空值跟随 VIDEO_SEARCH_MODE；off 单独关闭；bing_rss 单独开启
DOC_SEARCH_MODE=
